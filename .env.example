# Backend (FastAPI) environment — set these in your shell; the backend does not auto-load .env.
# PowerShell:  $env:LUNAR_CORS_ORIGINS = "http://localhost:5173,http://127.0.0.1:5173"

# Comma-separated explicit browser origins allowed by CORS. Wildcards ("*") are refused at startup.
LUNAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: absolute path to cspice.dll if spiceypy cannot locate its bundled CSPICE library.
# CSPICE_SHARED_LIB=C:\path\to\cspice.dll

# Frontend variables live in frontend/.env.example (VITE_API_BASE_URL).
